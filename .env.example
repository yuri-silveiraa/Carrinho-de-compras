# Variáveis de ambiente para o Login com Google (Opcionais)
# Para gerar estas credenciais no Google Cloud Console:
# 1. Acesse https://console.cloud.google.com/apis/credentials
# 2. Crie um projeto e configure a tela de consentimento OAuth
# 3. Crie IDs de cliente OAuth para Web, Android e iOS
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
